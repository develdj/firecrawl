# ===== Required Configuration =====

# API Server Configuration
PORT=3002
HOST=0.0.0.0
NODE_ENV=production

# Database Authentication (set to false for local deployment)
USE_DB_AUTHENTICATION=false

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_RATE_LIMIT_URL=redis://redis:6379

# ===== Ollama AI Configuration =====

# Ollama API endpoint
# Use your actual IP address instead of 172.17.0.1 for better reliability
OLLAMA_BASE_URL=http://192.168.1.81:11434/api

# LLM Model for extraction and processing
MODEL_NAME=gpt-oss:20b

# Embedding model for vector operations
MODEL_EMBEDDING_NAME=nomic-embed-text:v1.5

# ===== Bull Queue Configuration =====

# Password for Bull dashboard access
# IMPORTANT: Change this to a secure password!
BULL_AUTH_KEY=CHANGEME

# ===== Resource Limits (Jetson Optimized) =====

# Maximum CPU usage (0.0-1.0)
MAX_CPU=0.75

# Maximum RAM usage (0.0-1.0)
MAX_RAM=0.75

# Node.js memory limit
NODE_OPTIONS=--max-old-space-size=4096

# ===== Browser Configuration =====

PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ===== Optional: Proxy Configuration =====

# Proxy server URL or IP:PORT
# PROXY_SERVER=http://proxy.example.com:8080
# PROXY_USERNAME=
# PROXY_PASSWORD=

# ===== Optional: SearXNG Integration =====

# Use SearXNG for /search endpoint instead of Google
# SEARXNG_ENDPOINT=http://searxng-n8ggwkkkcgw8og0wwcc8coow:8080
# SEARXNG_ENGINES=google,bing,duckduckgo
# SEARXNG_CATEGORIES=general

# ===== Optional: Supabase (Advanced Features) =====

# Required for database authentication and advanced logging
# Not available in standard self-hosted setup
# SUPABASE_ANON_TOKEN=
# SUPABASE_URL=
# SUPABASE_SERVICE_TOKEN=

# ===== Optional: PDF Parsing =====

# LlamaParse API key for enhanced PDF parsing
# LLAMAPARSE_API_KEY=

# ===== Optional: Monitoring =====

# Slack webhook for server health notifications
# SLACK_WEBHOOK_URL=

# PostHog for analytics and job logging
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://app.posthog.com

# ===== Optional: Testing =====

# API key for testing authenticated endpoints
# TEST_API_KEY=
